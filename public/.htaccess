# =============================================================================
# cona-app - Apache / Hostinger (LiteSpeed compatible)
# Se copia a la raíz del build (dist/cona-app/browser). Subir ese contenido a public_html.
# =============================================================================

Options -Indexes
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /not-404/index.html
AddType video/webm .webm
AddType image/webp .webp
AddType image/svg+xml .svg

# -----------------------------------------------------------------------------
# 1. HTTPS obligatorio + fallback de la SPA
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Home prerenderizada.
  RewriteRule ^$ index.html [L]

  # Rutas prerenderizadas (/blog o /blog/ -> blog/index.html) sin redirección 301.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # Archivos reales (bundles, assets) se sirven tal cual.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Cualquier otra URL: estado 404 real con la página 404 prerenderizada (ErrorDocument).
  RewriteRule ^ - [R=404,L]
</IfModule>

# -----------------------------------------------------------------------------
# 2. Caché
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  # index.html siempre se revalida para que los usuarios reciban el último deploy.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Imágenes, videos y fuentes de /assets (sin hash): 7 días + revalidación en segundo plano.
  <FilesMatch "\.(jpe?g|png|webp|avif|gif|ico|svg|mp4|webm|woff2)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>

  # Archivos con hash en el nombre (main-AB12CD34.js, media/x-AB12CD34.woff2): inmutables 1 año.
  # Va AL FINAL para prevalecer sobre la regla anterior (en Apache gana la última cabecera aplicada).
  <FilesMatch "-[A-Za-z0-9]{8}\.(js|css|woff2?|jpe?g|png|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# 3. Compresión (LiteSpeed en Hostinger aplica Brotli automáticamente si está disponible)
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# 4. Cabeceras de seguridad
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  # HSTS: forzar HTTPS 1 año. Añadir "; includeSubDomains" solo si TODOS los subdominios tienen SSL.
  Header always set Strict-Transport-Security "max-age=31536000"

  # CSP:
  #  - script-src 'self': sin scripts inline (por eso inlineCritical está desactivado en angular.json).
  #  - style-src 'unsafe-inline': Angular inyecta los estilos de componentes en <style>.
  #  - img-src data:: Bootstrap usa SVG en data: URIs (icono del menú, validación de formularios).
  #  - connect-src formspree.io: envío del formulario de contacto.
  #  - frame-src youtube-nocookie / twitch e img-src i.ytimg.com: fachadas de video (iframe solo tras clic).
  #  - media-src/worker-src blob:: hls.js (MediaSource + Web Worker). Añadir a connect-src el origen del stream HLS.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; font-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://formspree.io; frame-src https://www.youtube-nocookie.com https://player.twitch.tv; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always unset X-Powered-By
</IfModule>
